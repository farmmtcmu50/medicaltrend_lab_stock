{
  "name": "medical-trend-lab-stock-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create medical-trend-lab-stock",
    "db:migrate:local": "wrangler d1 migrations apply medical-trend-lab-stock --local",
    "db:migrate:remote": "wrangler d1 migrations apply medical-trend-lab-stock --remote",
    "db:seed:local": "wrangler d1 execute medical-trend-lab-stock --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute medical-trend-lab-stock --remote --file=./seed.sql",
    "check": "wrangler deploy --dry-run",
    "subscription:setup": "node scripts/subscription.mjs init",
    "subscription:dev": "wrangler dev --config subscription/wrangler.jsonc --port 8790 --ip 127.0.0.1",
    "subscription:check": "wrangler deploy --config subscription/wrangler.jsonc --dry-run",
    "subscription:provision": "node scripts/subscription.mjs provision",
    "subscription:update": "node scripts/subscription.mjs update",
    "subscription:backup": "node scripts/subscription.mjs backup",
    "test:subscription": "node --test tests/subscription.test.mjs",
    "test:access": "node --test tests/access.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
